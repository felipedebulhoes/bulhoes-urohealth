{
  "hosting": {
    "site": "site-dr-felipe-bulhoes",
    "public": "firebase-hosting-empty",
    "ignore": [
      "firebase.production-preview.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "dr-felipe-site-production",
          "region": "southamerica-east1",
          "pinTag": true
        }
      }
    ]
  }
}
